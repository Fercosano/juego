{% extends 'base.html.twig' %}

{% block title %}Selección de Nivel{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/game.css') }}">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
{% endblock %}

{% block body %}
<div class="map-container">
    <a href="{{ path('app_home') }}" class="back-btn"><i class="fas fa-arrow-left"></i> Volver</a>
    
    <h1 class="map-title">Selecciona un Nivel</h1>
    
    <div class="map-nodes">
        {# Nivel 1 - Desbloqueado #}
        <a href="{{ path('app_game_level', {id: 1}) }}" class="level-node unlocked">
            1
        </a>
        
        {# Nivel 2 - Bloqueado #}
        <div class="level-node locked">
            2
            <i class="fas fa-lock" style="font-size: 1rem; margin-left: 5px;"></i>
        </div>
        
        {# Nivel 3 - Bloqueado #}
        <div class="level-node locked">
            3
            <i class="fas fa-lock" style="font-size: 1rem; margin-left: 5px;"></i>
        </div>
    </div>
</div>
{% endblock %}
