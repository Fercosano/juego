<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Hello world! Party{% endblock %}</title>
        
        {# Cambiamos el icono por uno más acorde a un juego #}
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%22100%22>🎮</text></svg>">
        
        {% block stylesheets %}
            {# Importmap cargará automáticamente assets/styles/app.css #}
            {{ importmap('app') }}
        {% endblock %}

        {% block javascripts %}
            {# Importmap cargará automáticamente assets/app.js #}
            {{ importmap('app') }}
        {% endblock %}
    </head>
    <body style="margin: 0; padding: 0; min-height: 100vh; overflow-x: hidden;">
        {# El bloque body es donde se inyectará el contenido de tu menú #}
        {% block body %}{% endblock %}
    </body>
</html>